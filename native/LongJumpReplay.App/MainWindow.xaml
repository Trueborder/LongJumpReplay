<Window x:Class="LongJumpReplay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Long Jump Replay · Native migration preview" WindowState="Maximized"
        MinWidth="1000" MinHeight="650" Background="#10151D" Foreground="#F4F7FB"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#18202B" CornerRadius="14" Padding="14" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <TextBlock x:Name="HeaderText" Text="LONG JUMP REPLAY" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,18,0" />
          <TextBlock x:Name="SourceText" Foreground="#9EB0C3" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <ComboBox x:Name="SourceSelector" Width="280" Margin="4" DisplayMemberPath="Name" VerticalContentAlignment="Center" />
          <Button x:Name="UseSourceButton" Content="Use source" Click="UseSourceButton_Click" />
          <Button x:Name="PauseButton" Content="Pause camera" Click="PauseButton_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#05080C" CornerRadius="14" ClipToBounds="True">
      <Grid>
        <Image x:Name="VideoImage" Stretch="Uniform" SnapsToDevicePixels="True" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#C018202B" CornerRadius="8" Padding="10,6">
          <TextBlock x:Name="ModeText" Text="LIVE" FontSize="18" FontWeight="Bold" Foreground="#44D19D" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,12,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="EarlierText" Text="Earlier" Foreground="#9EB0C3" VerticalAlignment="Center" Margin="8" />
      <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="100" Value="100" IsHitTestVisible="False" />
      <TextBlock x:Name="LatestText" Grid.Column="2" Text="Latest" Foreground="#9EB0C3" VerticalAlignment="Center" Margin="8" />
    </Grid>
    <Border Grid.Row="3" Background="#18202B" CornerRadius="14" Padding="10">
      <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="#9EB0C3" VerticalAlignment="Center" Margin="8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PreviousFrameButton" Content="◀ Frame" Click="PreviousFrame_Click" />
          <Button x:Name="FreezeButton" Content="Freeze" Background="#2D74DA" Foreground="White" Click="FreezeButton_Click" />
          <Button x:Name="NextFrameButton" Content="Frame ▶" Click="NextFrame_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
