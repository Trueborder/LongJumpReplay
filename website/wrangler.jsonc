{
  "$schema": "../licensing-api/node_modules/wrangler/config-schema.json",
  "name": "longjumpreplay",
  "main": "main-site-worker.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./tomaspisar.cz",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "tomaspisar.cz",
      "custom_domain": true
    },
    {
      "pattern": "www.tomaspisar.cz",
      "custom_domain": true
    },
    {
      "pattern": "relaylab.tomaspisar.cz",
      "custom_domain": true
    }
  ]
}
