{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longjumpreplay-licensing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "directory": "../website/tomaspisar.cz/account",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Created with:  wrangler d1 create longjumpreplay-licenses
  // That command prints the database_id - paste it here. It is not a secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "longjumpreplay-licenses",
      "database_id": "afd54a54-bccb-494c-ac6d-377b00652c40"
    }
  ],

  // Non-secret configuration. Secrets are set with `wrangler secret put` and
  // are listed in docs/LICENSE_SYSTEM.md - never put them in this file.
  "vars": {
    "ENVIRONMENT": "development",
    "MAX_DEVICES": "2",
    "VERIFICATION_CODE_TTL_MINUTES": "10",
    "MAX_VERIFICATION_ATTEMPTS": "5",
    "OFFLINE_VERIFICATION_WINDOW_DAYS": "30",
    "AUTHORIZATION_TTL_DAYS": "30",
    "SUBSCRIPTION_GRACE_DAYS": "7",
    "MAIL_FROM": "info@tomaspisar.cz",
    "MAIL_FROM_NAME": "LongJumpReplay",
    "PORTAL_ORIGIN": "https://account.tomaspisar.cz",
    "PORTAL_SESSION_TTL_DAYS": "30",
    // Stripe price IDs, resolved to a license type by src/config.ts. Fill these
    // from the Stripe dashboard; unknown price IDs are rejected rather than
    // guessed, so a mis-typed value fails loudly instead of issuing a license.
    "STRIPE_PRICE_LIFETIME": "price_1U5LRVRzuUbjN0GOz1g4eLth",
    "STRIPE_PRICE_SUBSCRIPTION": "price_1U5NVeRzuUbjN0GO8DTXza5u",
    // Development only. The production env block below omits these, so the
    // tight defaults in src/config.ts apply there.
    "RATE_LIMIT_REQUEST_CODE": "500",
    "RATE_LIMIT_VERIFY_CODE": "500",
    "RATE_LIMIT_ACTIVATE": "500",
    "RATE_LIMIT_ACTIVATION_KEY": "500",
    "RATE_LIMIT_VERIFY": "500"
  },

  "env": {
    "staging": {
      "name": "longjumpreplay-licensing-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "MAX_DEVICES": "2",
        "VERIFICATION_CODE_TTL_MINUTES": "10",
        "MAX_VERIFICATION_ATTEMPTS": "5",
        "OFFLINE_VERIFICATION_WINDOW_DAYS": "30",
        "AUTHORIZATION_TTL_DAYS": "30",
        "SUBSCRIPTION_GRACE_DAYS": "7",
        "MAIL_FROM": "info@tomaspisar.cz",
        "MAIL_FROM_NAME": "LongJumpReplay staging",
        "PORTAL_ORIGIN": "https://account.tomaspisar.cz",
        "PORTAL_SESSION_TTL_DAYS": "30",
        "STRIPE_PRICE_LIFETIME": "",
        "STRIPE_PRICE_SUBSCRIPTION": "",
        "RATE_LIMIT_REQUEST_CODE": "5",
        "RATE_LIMIT_VERIFY_CODE": "10",
        "RATE_LIMIT_ACTIVATE": "20",
        "RATE_LIMIT_ACTIVATION_KEY": "30",
        "RATE_LIMIT_VERIFY": "120"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "longjumpreplay-licenses-staging",
          "database_id": "6e80c8e7-b1da-4f60-9f76-bb3a0505d748"
        }
      ],
      "routes": [
        {
          "pattern": "api-staging.tomaspisar.cz/*",
          "zone_name": "tomaspisar.cz"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "MAX_DEVICES": "2",
        "VERIFICATION_CODE_TTL_MINUTES": "10",
        "MAX_VERIFICATION_ATTEMPTS": "5",
        "OFFLINE_VERIFICATION_WINDOW_DAYS": "30",
        "AUTHORIZATION_TTL_DAYS": "30",
        "SUBSCRIPTION_GRACE_DAYS": "7",
        "MAIL_FROM": "info@tomaspisar.cz",
        "MAIL_FROM_NAME": "LongJumpReplay",
        "PORTAL_ORIGIN": "https://account.tomaspisar.cz",
        "PORTAL_SESSION_TTL_DAYS": "30",
        "STRIPE_PRICE_LIFETIME": "price_1U5LRVRzuUbjN0GOz1g4eLth",
        "STRIPE_PRICE_SUBSCRIPTION": "price_1U5NVeRzuUbjN0GO8DTXza5u",
        "RATE_LIMIT_REQUEST_CODE": "5",
        "RATE_LIMIT_VERIFY_CODE": "10",
        "RATE_LIMIT_ACTIVATE": "20",
        "RATE_LIMIT_ACTIVATION_KEY": "30",
        "RATE_LIMIT_VERIFY": "120"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "longjumpreplay-licenses",
          "database_id": "afd54a54-bccb-494c-ac6d-377b00652c40"
        }
      ],
      "routes": [
        {
          "pattern": "api.tomaspisar.cz/*",
          "zone_name": "tomaspisar.cz"
        },
        {
          "pattern": "account.tomaspisar.cz/*",
          "zone_name": "tomaspisar.cz"
        }
      ]
    }
  }
}
